OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Infográfico local (Images API). Alternativa: dall-e-3
OPENAI_IMAGE_MODEL=gpt-image-1

# NotebookLM (notebooklm-py — API consumer não oficial)
# Login interativo no Chrome real a cada "Gerar no NotebookLM"
NOTEBOOKLM_STATE_PATH=.notebooklm/storage_state.json
# Chrome Linux (extract local via ./scripts/install_chrome_wsl.sh)
# NOTEBOOKLM_CHROME_PATH=.notebooklm/chrome/opt/google/chrome/google-chrome
